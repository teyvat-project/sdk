<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CatalystSharp</RootNamespace>
    <PackageId>CatalystSharp</PackageId>
    <Title>CatalystSharp</Title>
    <Authors>Natsuneko</Authors>
    <Company>Natsuneko Laboratory</Company>
    <Description>CatalystSharp is a .NET library that provides bindings for Natsuneko Laboratory Platform, enabling developers to create Catalyst applications using C# and .NET technologies.</Description>
    <PackageProjectUrl>https://github.com/teyvat-project/sdk</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/teyvat-project/sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- The real version is injected at release time: dotnet pack -p:Version=... -->
    <Version>0.0.0-dev</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
