{
  "name": "@natsuneko-laboratory/catalyst-sdk",
  "version": "0.0.0-dev",
  "description": "TypeScript/JavaScript SDK for the Natsuneko Laboratory platform",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "catalyst",
    "sdk",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teyvat-project/sdk.git",
    "directory": "packages/nodejs"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
